set_global_assignment -name FAMILY "Cyclone 10 LP"
set_global_assignment -name DEVICE 10CL006YU256C8G
set_global_assignment -name TOP_LEVEL_ENTITY digital_clock_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 17.1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"

set_global_assignment -name VERILOG_FILE rtl/digital_clock_top.v
set_global_assignment -name VERILOG_FILE rtl/clk_gen.v
set_global_assignment -name VERILOG_FILE rtl/nibble_key.v
set_global_assignment -name VERILOG_FILE rtl/core_key.v
set_global_assignment -name VERILOG_FILE rtl/key_input.v
set_global_assignment -name VERILOG_FILE rtl/key_ctrl.v
set_global_assignment -name VERILOG_FILE rtl/bcd_digit_adj.v
set_global_assignment -name VERILOG_FILE rtl/time_counter.v
set_global_assignment -name VERILOG_FILE rtl/alarm_ctrl.v
set_global_assignment -name VERILOG_FILE rtl/stopwatch.v
set_global_assignment -name VERILOG_FILE rtl/countdown.v
set_global_assignment -name VERILOG_FILE rtl/beep_ctrl.v
set_global_assignment -name VERILOG_FILE rtl/buzzer_tone.v
set_global_assignment -name VERILOG_FILE rtl/display_ctrl.v
set_global_assignment -name VERILOG_FILE rtl/seg_decode.v
set_global_assignment -name SDC_FILE DigitalClock.sdc

#------------------------------------------------------------------------------
# 50 MHz system clock
#------------------------------------------------------------------------------
set_location_assignment PIN_M15 -to clk50

#------------------------------------------------------------------------------
# Core board keys K1~K4 (active low)
#------------------------------------------------------------------------------
set_location_assignment PIN_P9 -to key_core_n[0]
set_location_assignment PIN_N9 -to key_core_n[1]
set_location_assignment PIN_M10 -to key_core_n[2]
set_location_assignment PIN_P11 -to key_core_n[3]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to key_core_n[*]

#------------------------------------------------------------------------------
# 8-digit 7-segment display: segments {g,f,e,d,c,b,a,dp}
# Measured on the real board (see test/seg_check): PO[0]=a, PO[1]=b, PO[2]=c,
# PO[3]=d, PO[4]=e, PO[5]=f, PO[6]=g, PO[7]=dp -- i.e. the OPPOSITE order of the
# manual text "PO[7:0] = g,f,e,d,c,b,a,point". So the pin order below is reversed
# on purpose: seg_n[7]=g -> PO[6], ... seg_n[0]=dp -> PO[7].
#------------------------------------------------------------------------------
set_location_assignment PIN_D1 -to seg_n[7]
set_location_assignment PIN_B3 -to seg_n[6]
set_location_assignment PIN_A3 -to seg_n[5]
set_location_assignment PIN_B5 -to seg_n[4]
set_location_assignment PIN_A5 -to seg_n[3]
set_location_assignment PIN_B7 -to seg_n[2]
set_location_assignment PIN_B6 -to seg_n[1]
set_location_assignment PIN_C2 -to seg_n[0]

#------------------------------------------------------------------------------
# Digit enables: dig_n[0]=digit1 (rightmost) ... dig_n[7]=digit8
#------------------------------------------------------------------------------
set_location_assignment PIN_J2 -to dig_n[0]
set_location_assignment PIN_G1 -to dig_n[1]
set_location_assignment PIN_L2 -to dig_n[2]
set_location_assignment PIN_K1 -to dig_n[3]
set_location_assignment PIN_P2 -to dig_n[4]
set_location_assignment PIN_N1 -to dig_n[5]
set_location_assignment PIN_R1 -to dig_n[6]
set_location_assignment PIN_L4 -to dig_n[7]

#------------------------------------------------------------------------------
# Mode 9 keys 1~4: PI[15:0]
#------------------------------------------------------------------------------
set_location_assignment PIN_T12 -to pi_in[15]
set_location_assignment PIN_R13 -to pi_in[14]
set_location_assignment PIN_T10 -to pi_in[13]
set_location_assignment PIN_R11 -to pi_in[12]
set_location_assignment PIN_T8 -to pi_in[11]
set_location_assignment PIN_R9 -to pi_in[10]
set_location_assignment PIN_T6 -to pi_in[9]
set_location_assignment PIN_R7 -to pi_in[8]
set_location_assignment PIN_T4 -to pi_in[7]
set_location_assignment PIN_R5 -to pi_in[6]
set_location_assignment PIN_K8 -to pi_in[5]
set_location_assignment PIN_R3 -to pi_in[4]
set_location_assignment PIN_N8 -to pi_in[3]
set_location_assignment PIN_M8 -to pi_in[2]
set_location_assignment PIN_P6 -to pi_in[1]
set_location_assignment PIN_L7 -to pi_in[0]

#------------------------------------------------------------------------------
# Mode 9 keys 5~8: PIO[15:0]
#------------------------------------------------------------------------------
set_location_assignment PIN_B4 -to pio_in[15]
set_location_assignment PIN_C3 -to pio_in[14]
set_location_assignment PIN_D3 -to pio_in[13]
set_location_assignment PIN_J1 -to pio_in[12]
set_location_assignment PIN_L1 -to pio_in[11]
set_location_assignment PIN_J6 -to pio_in[10]
set_location_assignment PIN_L3 -to pio_in[9]
set_location_assignment PIN_P3 -to pio_in[8]
set_location_assignment PIN_A4 -to pio_in[7]
set_location_assignment PIN_B1 -to pio_in[6]
set_location_assignment PIN_G2 -to pio_in[5]
set_location_assignment PIN_K2 -to pio_in[4]
set_location_assignment PIN_N2 -to pio_in[3]
set_location_assignment PIN_P1 -to pio_in[2]
set_location_assignment PIN_L6 -to pio_in[1]
set_location_assignment PIN_N5 -to pio_in[0]

#------------------------------------------------------------------------------
# Buzzer and LEDs
#------------------------------------------------------------------------------
set_location_assignment PIN_T13 -to buzzer
set_location_assignment PIN_T15 -to led_n[0]
set_location_assignment PIN_M9 -to led_n[1]
set_location_assignment PIN_L9 -to led_n[2]
set_location_assignment PIN_T14 -to led_n[3]

#------------------------------------------------------------------------------
# 3.3 V LVTTL for all user I/O
#------------------------------------------------------------------------------
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key_core_n[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg_n[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dig_n[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to pi_in[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to pio_in[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to buzzer
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_n[*]

# 输出驱动强度：数码管与蜂鸣器 8 mA（10CL006 的 3.3-V LVTTL 只支持 4/8 mA，12/16/24 mA 会被 Fitter 拒绝）
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to seg_n[*]
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to dig_n[*]
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to buzzer
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to led_n[*]

set_global_assignment -name LAST_QUARTUS_VERSION "17.1.0 Standard Edition"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
